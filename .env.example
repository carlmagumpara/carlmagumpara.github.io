GITHUB_USERNAME=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Build-time origin for the Vercel /api/github and /api/spotify functions.
# Replace the sample with your Vercel URL, or leave empty to use the current
# origin (what `vite dev` and the Vercel deployment serve).
VITE_VERCEL_API_ORIGIN=https://example.vercel.app

# Build-time WebSocket endpoint for live cursors. Replace the sample with your
# socket host, or leave empty to use the current origin (what `vite dev` and
# the Vercel deployment serve).
VITE_CURSOR_WS_URL=wss://example.vercel.app/api/cursor

# Server-only credentials for the unique visitor counter (/api/visitors).
# Create a free Redis database at https://upstash.com and copy the REST URL and
# token from its dashboard. These are read by the Vercel function, never by the
# browser, so they are NOT VITE_* variables. Set them in Vercel → Environment
# Variables (Production + Preview); copy them here only for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret used to HMAC-hash visitor ids before storing them. Generate one with:
# openssl rand -hex 32
VISITOR_HASH_SECRET=